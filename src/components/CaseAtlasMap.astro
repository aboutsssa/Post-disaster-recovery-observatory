---
const { cases } = Astro.props;
---

<div class="marker-map" aria-label="Pilot case locations">
  <div class="map-grain"></div>
  <div class="map-route route-one"></div>
  <div class="map-route route-two"></div>
  {cases.map((caseStudy) => (
    <a
      class="case-marker"
      href={`${import.meta.env.BASE_URL}${caseStudy.href.replace(/^\//, "")}`}
      style={`--x: ${caseStudy.marker.x}%; --y: ${caseStudy.marker.y}%;`}
      aria-label={`Open ${caseStudy.name}`}
    >
      <span class="marker-dot"></span>
      <span class="marker-label">
        <strong>{caseStudy.name}</strong>
        <small>{caseStudy.country} / {caseStudy.year}</small>
      </span>
    </a>
  ))}
</div>

<style>
  .marker-map {
    position: relative;
    overflow: hidden;
    min-height: clamp(360px, 54vw, 620px);
    border: 1px solid rgba(36, 48, 47, 0.14);
    border-radius: 8px;
    background:
      radial-gradient(circle at 28% 30%, rgba(239, 176, 87, 0.32), transparent 18%),
      radial-gradient(circle at 68% 42%, rgba(58, 118, 126, 0.24), transparent 22%),
      linear-gradient(145deg, #192322 0%, #24302f 45%, #4d493e 100%);
    box-shadow: 0 28px 80px rgba(18, 28, 27, 0.18);
  }

  .marker-map::before,
  .marker-map::after {
    content: "";
    position: absolute;
    inset: 10%;
    border: 1px solid rgba(244, 247, 245, 0.12);
    border-radius: 49% 51% 45% 55%;
    transform: rotate(-10deg);
  }

  .marker-map::after {
    inset: 22% 16%;
    border-color: rgba(241, 184, 75, 0.18);
    transform: rotate(14deg);
  }

  .map-grain {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle at center, black, transparent 78%);
  }

  .map-route {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(241, 184, 75, 0.58), transparent);
    transform-origin: left center;
  }

  .route-one { left: 42%; top: 49%; width: 26%; transform: rotate(-14deg); }
  .route-two { left: 50%; top: 53%; width: 19%; transform: rotate(-54deg); }

  .case-marker {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 2;
    display: grid;
    gap: 0.55rem;
    max-width: 230px;
    color: #f7f2e8;
    text-decoration: none;
    transform: translate(-16px, -16px);
  }

  .marker-dot {
    width: 32px;
    height: 32px;
    border: 2px solid #f7f2e8;
    border-radius: 999px;
    background: #f1b84b;
    box-shadow: 0 0 0 10px rgba(241, 184, 75, 0.18), 0 0 32px rgba(241, 184, 75, 0.42);
    transition: transform 160ms ease;
  }

  .marker-label {
    display: grid;
    gap: 0.1rem;
    border-left: 1px solid rgba(247, 242, 232, 0.45);
    padding-left: 0.75rem;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.45);
  }

  .marker-label strong { font-size: 0.96rem; line-height: 1.2; }
  .marker-label small { color: rgba(247, 242, 232, 0.74); font-weight: 750; text-transform: uppercase; }
  .case-marker:hover .marker-dot { transform: scale(1.12); }

  @media (max-width: 680px) {
    .marker-label { max-width: 150px; font-size: 0.86rem; }
  }
</style>
