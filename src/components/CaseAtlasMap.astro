---
import { worldMapPaths } from "../data/worldMapPaths.js";

const { cases } = Astro.props;
const width = 1000;
const height = 500;
const project = (latitude, longitude) => ({
  x: ((Number(longitude) + 180) / 360) * width,
  y: ((90 - Number(latitude)) / 180) * height
});

const markers = cases
  .map((caseStudy) => {
    const latitude = caseStudy.event?.latitude;
    const longitude = caseStudy.event?.longitude;
    if (!Number.isFinite(Number(latitude)) || !Number.isFinite(Number(longitude))) return null;
    return {
      id: caseStudy.id,
      name: caseStudy.name,
      country: caseStudy.country,
      year: caseStudy.year,
      href: `${import.meta.env.BASE_URL}${caseStudy.href.replace(/^\//, "")}`,
      magnitude: caseStudy.event?.magnitude,
      ...project(latitude, longitude)
    };
  })
  .filter(Boolean);

const graticuleX = [-120, -60, 0, 60, 120].map((longitude) => ((longitude + 180) / 360) * width);
const graticuleY = [-60, -30, 0, 30, 60].map((latitude) => ((90 - latitude) / 180) * height);
---

<div class="atlas-map-shell">
  <svg class="atlas-map" viewBox={`0 0 ${width} ${height}`} role="img" aria-label="World map locating disaster recovery cases">
    <rect class="ocean" width={width} height={height}></rect>
    {graticuleX.map((x) => <line class="graticule" x1={x} y1="0" x2={x} y2={height} />)}
    {graticuleY.map((y) => <line class="graticule" x1="0" y1={y} x2={width} y2={y} />)}
    <g class="land">
      {worldMapPaths.map((path) => <path d={path}></path>)}
    </g>
    <g class="markers">
      {markers.map((marker, index) => (
        <a href={marker.href} aria-label={`Open ${marker.name}`}>
          <circle class="marker-halo" cx={marker.x} cy={marker.y} r="15"></circle>
          <circle class="marker" cx={marker.x} cy={marker.y} r="6.5"></circle>
          <text
            x={marker.x + 11}
            y={marker.y + (index === 1 ? -9 : 18)}
            text-anchor={index === 1 ? "start" : "start"}
          >
            {marker.year} / {marker.country}
          </text>
          <title>{marker.name} / M {marker.magnitude}</title>
        </a>
      ))}
    </g>
  </svg>
  <div class="atlas-map-caption">
    <span>Local Natural Earth vector basemap</span>
    <span>Markers locate event epicenters; analytical boundaries are shown inside each case observatory.</span>
  </div>
</div>

<style>
  .atlas-map-shell {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #f6f3ec;
    box-shadow: var(--shadow);
  }

  .atlas-map {
    display: block;
    width: 100%;
    min-height: 430px;
    aspect-ratio: 2 / 1;
  }

  .ocean {
    fill: #dbe5e2;
  }

  .graticule {
    stroke: rgba(36, 48, 47, 0.13);
    stroke-width: 0.8;
  }

  .land path {
    fill: #f8f7f2;
    stroke: rgba(92, 101, 98, 0.42);
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
  }

  .markers a {
    color: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .marker-halo {
    fill: rgba(195, 91, 56, 0.14);
    stroke: rgba(195, 91, 56, 0.22);
    stroke-width: 1.2;
  }

  .marker {
    fill: #c35b38;
    stroke: #24302f;
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }

  .markers a:hover .marker,
  .markers a:focus .marker {
    fill: #116d72;
  }

  .markers text {
    fill: #24302f;
    font-size: 14px;
    font-weight: 850;
    paint-order: stroke;
    stroke: #f8f7f2;
    stroke-linejoin: round;
    stroke-width: 4px;
  }

  .atlas-map-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    padding: 0.8rem 1rem;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .atlas-map-caption span:first-child {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .atlas-map {
      min-height: 310px;
    }

    .markers text {
      font-size: 18px;
    }
  }
</style>
