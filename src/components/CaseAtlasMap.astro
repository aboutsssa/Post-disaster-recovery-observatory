---
const { cases } = Astro.props;

const markers = cases.map((caseStudy) => ({
  id: caseStudy.id,
  name: caseStudy.name,
  country: caseStudy.country,
  year: caseStudy.year,
  href: `${import.meta.env.BASE_URL}${caseStudy.href.replace(/^\//, "")}`,
  latitude: caseStudy.event?.latitude,
  longitude: caseStudy.event?.longitude,
  magnitude: caseStudy.event?.magnitude
}));
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIINfQPDLaB7KjRA5/0M4QGzX5hnRraRYQk="
  crossorigin=""
/>

<div class="atlas-map-shell">
  <div id="case-atlas-map" class="case-atlas-map" data-markers={JSON.stringify(markers)}></div>
  <div class="atlas-map-caption">
    <span>Standard Web Mercator basemap</span>
    <span>Markers locate event epicenters; case-specific boundaries are shown on individual observatory pages.</span>
  </div>
</div>

<script
  is:inline
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
></script>

<script is:inline>
  const mapElement = document.getElementById("case-atlas-map");
  if (mapElement && window.L) {
    const markers = JSON.parse(mapElement.dataset.markers || "[]");
    const map = L.map(mapElement, {
      scrollWheelZoom: false,
      zoomControl: true,
      worldCopyJump: true
    }).setView([30, 104], 3);

    L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
      maxZoom: 8,
      minZoom: 2,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
    }).addTo(map);

    const bounds = [];
    markers.forEach((item) => {
      const lat = Number(item.latitude);
      const lng = Number(item.longitude);
      if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
      bounds.push([lat, lng]);
      const marker = L.circleMarker([lat, lng], {
        radius: 8,
        color: "#24302f",
        weight: 1.8,
        fillColor: "#c35b38",
        fillOpacity: 0.92
      }).addTo(map);
      marker.bindPopup(
        `<strong>${item.name}</strong><br>${item.country} / ${item.year}<br>M ${item.magnitude}<br><a href="${item.href}">Open observatory</a>`
      );
    });

    if (bounds.length > 1) {
      map.fitBounds(bounds, { padding: [60, 60], maxZoom: 4 });
    }
  }
</script>

<style>
  .atlas-map-shell {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-strong);
    box-shadow: var(--shadow);
  }

  .case-atlas-map {
    width: 100%;
    height: min(68vh, 640px);
    min-height: 430px;
    background: #dfe7e5;
  }

  .case-atlas-map :global(.leaflet-container) {
    font-family: inherit;
  }

  .atlas-map-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    padding: 0.8rem 1rem;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .atlas-map-caption span:first-child {
    color: var(--ink);
  }

  :global(.leaflet-popup-content) {
    color: var(--ink);
    line-height: 1.45;
  }

  :global(.leaflet-popup-content a) {
    color: var(--terracotta);
    font-weight: 800;
    text-decoration: none;
  }
</style>
