---
const { spatial } = Astro.props;
const defaultMetric = "gdp_index_change_2008_2020";
const metricMap = Object.fromEntries(
  Object.entries(spatial.metrics).map(([key, value]) => [
    key,
    { label: value[0], unit: value[1], module: value[2], min: value[3], max: value[4], median: value[5] }
  ])
);
const defaultMeta = metricMap[defaultMetric];
const metricEntries = Object.entries(metricMap);
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIINfQPDLaB7KjRA5/0M4QGzX5hnRraRYQk="
  crossorigin=""
/>

<article class="card county-map-card" data-county-map data-default-metric={defaultMetric}>
  <script type="application/json" id="county-spatial-data" set:html={JSON.stringify(spatial)}></script>
  <div class="county-map-head">
    <div>
      <p class="eyebrow">County Vector Map</p>
      <h3>{spatial.title}</h3>
      <p>{spatial.source}</p>
    </div>
    <div class="metric-switcher" aria-label="County map metric">
      {metricEntries.map(([key, meta]) => (
        <button type="button" class={key === defaultMetric ? "active" : ""} data-metric={key}>
          {meta.label}
        </button>
      ))}
    </div>
  </div>

  <div class="county-map-grid">
    <div id="wenchuan-county-map" class="county-leaflet-map" aria-label="County-level vector map"></div>
    <aside class="county-map-info">
      <span class="status-badge status-available">spatialized panel</span>
      <h3 data-map-title>{defaultMeta.label}</h3>
      <dl>
        <div>
          <dt>Module</dt>
          <dd data-map-module>{defaultMeta.module}</dd>
        </div>
        <div>
          <dt>Range</dt>
          <dd data-map-range>{defaultMeta.min.toLocaleString()}-{defaultMeta.max.toLocaleString()} {defaultMeta.unit}</dd>
        </div>
        <div>
          <dt>Selected unit</dt>
          <dd data-map-selection>Hover a county to inspect its value.</dd>
        </div>
      </dl>
      <div class="map-ramp" aria-hidden="true"></div>
      <p>{spatial.matching_note}</p>
    </aside>
  </div>
</article>

<script
  is:inline
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
></script>

<script is:inline>
  const root = document.querySelector("[data-county-map]");
  const mapElement = document.getElementById("wenchuan-county-map");
  const dataElement = document.getElementById("county-spatial-data");

  if (root && mapElement && dataElement && window.L) {
    const spatial = JSON.parse(dataElement.textContent || "{}");
    const metricMeta = Object.fromEntries(
      Object.entries(spatial.metrics || {}).map(([key, value]) => [
        key,
        { label: value[0], unit: value[1], module: value[2], min: value[3], max: value[4], median: value[5] }
      ])
    );
    const columns = spatial.columns || [];
    const metricsByName = new Map(
      (spatial.rows || []).map((row) => [
        row[0],
        Object.fromEntries(columns.map((column, index) => [column, row[index + 1]]))
      ])
    );
    const buttons = Array.from(root.querySelectorAll("[data-metric]"));
    const title = root.querySelector("[data-map-title]");
    const moduleLabel = root.querySelector("[data-map-module]");
    const rangeLabel = root.querySelector("[data-map-range]");
    const selection = root.querySelector("[data-map-selection]");
    let activeMetric = root.dataset.defaultMetric;
    let countyLayer;

    const map = L.map(mapElement, {
      scrollWheelZoom: false,
      zoomControl: true
    }).setView([30.7, 102.8], 6);

    L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
      maxZoom: 10,
      minZoom: 5,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
    }).addTo(map);

    const colorFor = (value, meta) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return "#d7dfdc";
      const min = Number(meta.min);
      const max = Number(meta.max);
      const ratio = max === min ? 0.5 : Math.max(0, Math.min(1, (number - min) / (max - min)));
      const stops = [[239, 244, 238], [135, 181, 164], [20, 100, 109], [128, 54, 38]];
      const scaled = ratio * (stops.length - 1);
      const index = Math.min(stops.length - 2, Math.floor(scaled));
      const local = scaled - index;
      const rgb = stops[index].map((channel, channelIndex) =>
        Math.round(channel + (stops[index + 1][channelIndex] - channel) * local)
      );
      return `rgb(${rgb.join(",")})`;
    };

    const formatValue = (value, unit) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return "no data";
      return `${number.toLocaleString(undefined, { maximumFractionDigits: 2 })} ${unit}`;
    };

    const resolvePanelName = (feature, cityName) => {
      const name = feature.properties?.name;
      return spatial.aliases?.[`${name}|${cityName}`] || spatial.aliases?.[name] || name;
    };

    const styleFor = (feature) => {
      const values = metricsByName.get(feature.properties.panelName);
      const meta = metricMeta[activeMetric];
      return {
        color: "rgba(255,255,255,0.82)",
        fillColor: colorFor(values?.[activeMetric], meta),
        fillOpacity: 0.86,
        opacity: 1,
        weight: 0.8
      };
    };

    const setMetric = (metricKey) => {
      const meta = metricMeta[metricKey];
      if (!meta) return;
      activeMetric = metricKey;
      title.textContent = meta.label;
      moduleLabel.textContent = meta.module;
      rangeLabel.textContent = `${Number(meta.min).toLocaleString()}-${Number(meta.max).toLocaleString()} ${meta.unit}`;
      selection.textContent = "Hover a county to inspect its value.";
      buttons.forEach((button) => button.classList.toggle("active", button.dataset.metric === metricKey));
      if (countyLayer) countyLayer.setStyle(styleFor);
    };

    const attachFeatureEvents = (feature, layer) => {
      layer.on({
        mouseover: () => {
          layer.setStyle({ color: "#24302f", weight: 1.8 });
          const meta = metricMeta[activeMetric];
          const values = metricsByName.get(feature.properties.panelName);
          selection.textContent = `${feature.properties.panelName} / ${feature.properties.parentCity}: ${formatValue(values?.[activeMetric], meta.unit)}`;
        },
        mouseout: () => {
          countyLayer.resetStyle(layer);
        },
        click: () => {
          const meta = metricMeta[activeMetric];
          const values = metricsByName.get(feature.properties.panelName);
          layer.bindPopup(
            `<strong>${feature.properties.panelName}</strong><br>${feature.properties.parentCity}<br>${meta.label}: ${formatValue(values?.[activeMetric], meta.unit)}`
          ).openPopup();
        }
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => setMetric(button.dataset.metric));
    });

    Promise.all(
      (spatial.city_codes || []).map(async (city) => {
        const cityCode = city[0];
        const cityName = city[1];
        const response = await fetch(`https://geo.datav.aliyun.com/areas_v3/bound/${cityCode}_full.json`);
        const geojson = await response.json();
        geojson.features = geojson.features
          .map((feature) => {
            const panelName = resolvePanelName(feature, cityName);
            feature.properties.parentCity = cityName;
            feature.properties.panelName = panelName;
            return feature;
          })
          .filter((feature) => metricsByName.has(feature.properties.panelName));
        return geojson.features;
      })
    ).then((featureGroups) => {
      const featureCollection = {
        type: "FeatureCollection",
        features: featureGroups.flat()
      };
      countyLayer = L.geoJSON(featureCollection, {
        style: styleFor,
        onEachFeature: attachFeatureEvents
      }).addTo(map);
      map.fitBounds(countyLayer.getBounds(), { padding: [22, 22] });
      setMetric(activeMetric);
    }).catch(() => {
      selection.textContent = "County boundary service is temporarily unavailable.";
    });
  }
</script>

<style>
  .county-map-card,
  .county-map-head {
    display: grid;
    gap: 1.25rem;
  }

  .county-map-head p {
    margin: 0.65rem 0 0;
    color: var(--muted);
  }

  .metric-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .metric-switcher button {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #edf5f3;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.34rem 0.68rem;
  }

  .metric-switcher button.active,
  .metric-switcher button:hover {
    border-color: rgba(17, 109, 114, 0.45);
    background: var(--ink);
    color: var(--surface);
  }

  .county-map-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(260px, 0.65fr);
    gap: 1rem;
    align-items: stretch;
  }

  .county-leaflet-map {
    min-height: 560px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #dfe7e5;
  }

  .county-map-info {
    display: grid;
    align-content: start;
    gap: 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #f9fbfa;
    padding: 1rem;
  }

  .county-map-info dl {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .county-map-info p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .map-ramp {
    height: 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: linear-gradient(90deg, #eff4ee, #87b5a4, #14646d, #803626);
  }

  :global(.leaflet-popup-content) {
    color: var(--ink);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .county-map-grid {
      grid-template-columns: 1fr;
    }

    .county-leaflet-map {
      min-height: 440px;
    }
  }
</style>
