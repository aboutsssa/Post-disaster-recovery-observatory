---
const { spatial } = Astro.props;
const defaultMetric = "gdp_index_change_2008_2020";
const metricMap = Object.fromEntries(
  Object.entries(spatial.metrics).map(([key, value]) => [
    key,
    { label: value[0], unit: value[1], module: value[2], min: value[3], max: value[4], median: value[5] }
  ])
);
const defaultMeta = metricMap[defaultMetric];
const metricEntries = Object.entries(metricMap);
const viewBox = spatial.viewBox?.join(" ") || "0 0 760 620";
---

<article class="card county-map-card" data-county-map data-default-metric={defaultMetric}>
  <script type="application/json" id="county-metric-meta" set:html={JSON.stringify(metricMap)}></script>
  <div class="county-map-head">
    <div>
      <p class="eyebrow">County Vector Map</p>
      <h3>{spatial.title}</h3>
      <p>{spatial.source}</p>
    </div>
    <div class="metric-switcher" aria-label="County map metric">
      {metricEntries.map(([key, meta]) => (
        <button type="button" class={key === defaultMetric ? "active" : ""} data-metric={key}>
          {meta.label}
        </button>
      ))}
    </div>
  </div>

  <div class="county-map-grid">
    <div class="county-vector-map" aria-label="County-level vector map">
      <svg viewBox={viewBox} role="img">
        <rect class="county-map-bg" width="100%" height="100%"></rect>
        <g class="county-features">
          {spatial.features.map((feature) => (
            <path
              d={feature.path}
              data-county-feature
              data-name={feature.name}
              data-city={feature.city}
              data-metrics={JSON.stringify(feature.metrics)}
            >
              <title>{feature.name} / {feature.city}</title>
            </path>
          ))}
        </g>
      </svg>
    </div>
    <aside class="county-map-info">
      <span class="status-badge status-available">spatialized panel</span>
      <h3 data-map-title>{defaultMeta.label}</h3>
      <dl>
        <div>
          <dt>Module</dt>
          <dd data-map-module>{defaultMeta.module}</dd>
        </div>
        <div>
          <dt>Range</dt>
          <dd data-map-range>{defaultMeta.min.toLocaleString()}-{defaultMeta.max.toLocaleString()} {defaultMeta.unit}</dd>
        </div>
        <div>
          <dt>Selected unit</dt>
          <dd data-map-selection>Hover a county to inspect its value.</dd>
        </div>
      </dl>
      <div class="map-ramp" aria-hidden="true"></div>
      <p>{spatial.matching_note}</p>
    </aside>
  </div>
</article>

<script is:inline>
  const root = document.querySelector("[data-county-map]");
  const metaElement = document.getElementById("county-metric-meta");

  if (root && metaElement) {
    const metricMeta = JSON.parse(metaElement.textContent || "{}");
    const features = Array.from(root.querySelectorAll("[data-county-feature]"));
    const buttons = Array.from(root.querySelectorAll("[data-metric]"));
    const title = root.querySelector("[data-map-title]");
    const moduleLabel = root.querySelector("[data-map-module]");
    const rangeLabel = root.querySelector("[data-map-range]");
    const selection = root.querySelector("[data-map-selection]");
    let activeMetric = root.dataset.defaultMetric;

    const colorFor = (value, meta) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return "#26332f";
      const min = Number(meta.min);
      const max = Number(meta.max);
      const ratio = max === min ? 0.5 : Math.max(0, Math.min(1, (number - min) / (max - min)));
      const stops = [[38, 51, 47], [90, 139, 124], [62, 172, 164], [228, 134, 99]];
      const scaled = ratio * (stops.length - 1);
      const index = Math.min(stops.length - 2, Math.floor(scaled));
      const local = scaled - index;
      const rgb = stops[index].map((channel, channelIndex) =>
        Math.round(channel + (stops[index + 1][channelIndex] - channel) * local)
      );
      return `rgb(${rgb.join(",")})`;
    };

    const formatValue = (value, unit) => {
      const number = Number(value);
      if (!Number.isFinite(number)) return "no data";
      return `${number.toLocaleString(undefined, { maximumFractionDigits: 2 })} ${unit}`;
    };

    const readMetrics = (path) => JSON.parse(path.dataset.metrics || "{}");

    const paintFeatures = () => {
      const meta = metricMeta[activeMetric];
      features.forEach((path) => {
        const value = readMetrics(path)[activeMetric];
        path.style.fill = colorFor(value, meta);
      });
    };

    const setMetric = (metricKey) => {
      const meta = metricMeta[metricKey];
      if (!meta) return;
      activeMetric = metricKey;
      title.textContent = meta.label;
      moduleLabel.textContent = meta.module;
      rangeLabel.textContent = `${Number(meta.min).toLocaleString()}-${Number(meta.max).toLocaleString()} ${meta.unit}`;
      selection.textContent = "Hover a county to inspect its value.";
      buttons.forEach((button) => button.classList.toggle("active", button.dataset.metric === metricKey));
      paintFeatures();
    };

    features.forEach((path) => {
      path.addEventListener("mouseenter", () => {
        path.classList.add("active");
        const meta = metricMeta[activeMetric];
        const value = readMetrics(path)[activeMetric];
        selection.textContent = `${path.dataset.name} / ${path.dataset.city}: ${formatValue(value, meta.unit)}`;
      });
      path.addEventListener("mouseleave", () => {
        path.classList.remove("active");
      });
      path.addEventListener("click", () => {
        const meta = metricMeta[activeMetric];
        const value = readMetrics(path)[activeMetric];
        selection.textContent = `${path.dataset.name} / ${path.dataset.city}: ${formatValue(value, meta.unit)}`;
      });
    });

    buttons.forEach((button) => {
      button.addEventListener("click", () => setMetric(button.dataset.metric));
    });

    setMetric(activeMetric);
  }
</script>

<style>
  .county-map-card,
  .county-map-head {
    display: grid;
    gap: 1.25rem;
  }

  .county-map-head p {
    margin: 0.65rem 0 0;
    color: var(--muted);
  }

  .metric-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .metric-switcher button {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #20302b;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.34rem 0.68rem;
  }

  .metric-switcher button.active,
  .metric-switcher button:hover {
    border-color: rgba(99, 195, 183, 0.45);
    background: var(--ink);
    color: var(--surface);
  }

  .county-map-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(260px, 0.65fr);
    gap: 1rem;
    align-items: stretch;
  }

  .county-vector-map {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(19, 28, 26, 0.92), rgba(24, 36, 32, 0.86));
  }

  .county-vector-map svg {
    display: block;
    width: 100%;
    min-height: 560px;
  }

  .county-map-bg {
    fill: #101817;
  }

  .county-features path {
    cursor: pointer;
    fill: #26332f;
    stroke: rgba(244, 239, 228, 0.28);
    stroke-linejoin: round;
    stroke-width: 1.1;
    transition: fill 160ms ease, stroke 160ms ease, stroke-width 160ms ease;
    vector-effect: non-scaling-stroke;
  }

  .county-features path:hover,
  .county-features path.active {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .county-map-info {
    display: grid;
    align-content: start;
    gap: 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #17231f;
    padding: 1rem;
  }

  .county-map-info dl {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .county-map-info p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .map-ramp {
    height: 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: linear-gradient(90deg, #26332f, #5a8b7c, #3eaca4, #e48663);
  }

  @media (max-width: 900px) {
    .county-map-grid {
      grid-template-columns: 1fr;
    }

    .county-vector-map svg {
      min-height: 440px;
    }
  }
</style>
