---
const { caseStudy } = Astro.props;
const hazards = Array.isArray(caseStudy.hazards) ? caseStudy.hazards.join(", ") : caseStudy.hazards;
const href = caseStudy.href ? `${import.meta.env.BASE_URL}${caseStudy.href.replace(/^\//, "")}` : null;
const summary = caseStudy.summary || caseStudy.researchFocus;
---

<article class="card case-card">
  <div class="case-meta">
    <span>{caseStudy.year}</span>
    <span>{caseStudy.country}</span>
  </div>
  <h3>{href ? <a href={href}>{caseStudy.name}</a> : caseStudy.name}</h3>
  <p>{summary}</p>
  <dl class="case-facts">
    <div>
      <dt>Event</dt>
      <dd>{caseStudy.eventDate}</dd>
    </div>
    <div>
      <dt>Primary hazards</dt>
      <dd>{hazards}</dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd>{caseStudy.status || "Case page"}</dd>
    </div>
  </dl>
  {href && <a class="case-link" href={href}>Open observatory</a>}
</article>
