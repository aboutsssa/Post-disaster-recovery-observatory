---
import BaseLayout from "../layouts/BaseLayout.astro";

const modules = [
  {
    name_en: "Disaster Impact",
    description: "Measures event shock, affected geography, exposed people and settlements, damage patterns, and secondary hazards.",
    required_indicators: ["Magnitude", "Epicenter", "Affected area", "Building damage", "Population exposure", "Disaster geography"],
    optional_indicators: ["Fatalities and injuries", "Lifeline interruption", "Landslide or inundation zones", "Relief accessibility"]
  },
  {
    name_en: "Ecological Recovery",
    description: "Tracks environmental disturbance and recovery using vegetation, ecosystem service value, pollution, temperature, and land-system indicators.",
    required_indicators: ["NDVI", "ESV", "CO2", "O3", "PM10", "Temperature"],
    optional_indicators: ["Soil erosion", "Water bodies", "Habitat fragmentation", "Slope vegetation recovery"]
  },
  {
    name_en: "Economic Recovery",
    description: "Monitors local economic activity, sector output, public expenditure, investment, and productivity recovery.",
    required_indicators: ["Real GDP", "GDP index", "Sector output", "Fiscal expenditure", "Fixed-asset investment"],
    optional_indicators: ["Employment", "Tourism recovery", "Business registration", "Household income"]
  },
  {
    name_en: "Population & Settlement",
    description: "Examines population change, urbanization, settlement rebuilding, relocation, built-up expansion, and accessibility.",
    required_indicators: ["Population", "Urbanization", "Built-up area expansion", "Housing reconstruction", "Relocation"],
    optional_indicators: ["School and clinic access", "Migration flows", "Temporary shelter", "Road network recovery"]
  },
  {
    name_en: "Social Sensing",
    description: "Uses event-related social media, news, reports, interviews, and field notes to understand attention, needs, sentiment, and lived recovery.",
    required_indicators: ["Public attention", "Topics", "Needs", "Sentiment", "Risk perception", "Textual data"],
    optional_indicators: ["Misinformation", "Trust", "Community memory", "Volunteer activity"]
  },
  {
    name_en: "Policy & Reconstruction",
    description: "Documents reconstruction strategies, planning zones, fiscal input, governance mechanisms, and policy milestones.",
    required_indicators: ["Reconstruction strategy", "Fiscal input", "Policy timeline", "Planning zones", "Governance mechanisms"],
    optional_indicators: ["Aid coordination", "Land-use regulation", "Building codes", "Public participation"]
  }
];
---

<BaseLayout title="Indicators - Recovery Observatory">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Indicator System</p>
      <h1>Six modules for long-term recovery observation.</h1>
      <p class="lead">
        The modules are a research frame, not a limit on layout. A case page can
        show many charts, notes, and evidence gaps under each module.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid two">
        {
          modules.map((module, index) => (
            <article class="card module-card">
              <span class="module-index">{String(index + 1).padStart(2, "0")}</span>
              <h3>{module.name_en}</h3>
              <p>{module.description}</p>
              <div class="tag-list" aria-label={`${module.name_en} required indicators`}>
                {module.required_indicators.map((indicator) => <span>{indicator}</span>)}
              </div>
              <h3>Optional indicators</h3>
              <div class="tag-list">
                {module.optional_indicators.map((indicator) => <span>{indicator}</span>)}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
