---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModuleCard from "../components/ModuleCard.astro";

const modules = [
  { name_en: "Disaster Impact", description: "Event shock, exposed settlements, damage footprints, and analytical disaster geography.", required_indicators: ["Magnitude", "Epicenter", "Affected area", "Damage footprint", "Population exposure"] },
  { name_en: "Ecological Recovery", description: "Vegetation recovery, land-cover transition, ecosystem service value, thermal environment, and pollution signals.", required_indicators: ["NDVI", "ESV", "CO2", "O3", "PM10", "Temperature"] },
  { name_en: "Economic Recovery", description: "Local economic activity, sector structure, public expenditure, investment, and productivity recovery.", required_indicators: ["Real GDP", "GDP index", "Industry output", "Fiscal expenditure", "Investment"] },
  { name_en: "Population & Settlement", description: "Population redistribution, urbanization, settlement rebuilding, relocation, and accessibility change.", required_indicators: ["Population", "Urbanization", "Built-up area", "Relocation", "Accessibility"] },
  { name_en: "Social Sensing", description: "Public attention, needs, sentiment, topics, and risk perception from reports, news, social media, and field records.", required_indicators: ["Attention", "Needs", "Topics", "Sentiment", "Field notes"] },
  { name_en: "Policy & Reconstruction", description: "Reconstruction strategies, governance arrangements, fiscal input, land-use decisions, and recovery milestones.", required_indicators: ["Policy timeline", "Planning zones", "Fiscal input", "Governance", "Milestones"] }
];
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">ReSpace Lab / Recovery / Resilience / Reimagine</p>
      <h1>Post-disaster Recovery Observatory</h1>
      <p class="lead">
        A reusable geospatial website template for tracking how disaster-affected
        regions recover over years and decades.
      </p>
      <div class="hero-actions">
        <a class="button" href={`${import.meta.env.BASE_URL}cases/`}>Open Case Atlas</a>
        <a class="button secondary" href={`${import.meta.env.BASE_URL}methods/`}>Review Methods</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Research Position</p>
          <h2>Recovery is multi-dimensional, spatial, and long-term.</h2>
        </div>
        <p>
          The site is being optimized as a case-based observatory. National-scale
          context is removed from the dashboard so the evidence stays focused on
          disaster regions and the people, settlements, ecosystems, and policies
          within them.
        </p>
      </div>
      <div class="grid three">
        {modules.map((module, index) => <ModuleCard module={module} index={index} />)}
      </div>
    </div>
  </section>
</BaseLayout>
