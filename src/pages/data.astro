---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Data - Recovery Observatory">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Data Structure</p>
      <h1>Plain files for affected-area recovery research.</h1>
      <p class="lead">Each case keeps metadata, module CSV files, provenance logs, and future boundary GeoJSON files. Chart-ready values should be generated only after data are aggregated inside the disaster boundary or affected administrative units.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <pre class="data-tree"><code>public/data/
├── indicators.json
├── processed/
│   └── nepal-gorkha-2015/
│       ├── observatory.json
│       └── reliefweb_report_frequency.csv
├── provenance/
│   └── nepal-gorkha-2015/
│       ├── processing_notes.json
│       ├── reliefweb_reports.json
│       └── usgs_event.json
└── cases/
    ├── wenchuan-2008/
    │   ├── metadata.yml
    │   ├── disaster-impact.csv
    │   ├── ecological-recovery.csv
    │   ├── economic-recovery.csv
    │   ├── population-settlement.csv
    │   ├── social-sensing.csv
    │   └── policy-reconstruction.csv
    ├── japan-311-2011/
    └── nepal-gorkha-2015/</code></pre>
    </div>
  </section>
</BaseLayout>
