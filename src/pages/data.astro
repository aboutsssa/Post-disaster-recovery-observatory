---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Data · Recovery Observatory">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Data Structure</p>
      <h1>Plain files for transparent, reusable research.</h1>
      <p class="lead">
        Each case keeps source-facing module files, processed chart-ready outputs,
        and provenance logs so values can be traced back to public APIs or
        documented datasets.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <pre class="data-tree"><code>public/data/
├── indicators.json
├── processed/
│   └── nepal-gorkha-2015/
│       ├── observatory.json
│       ├── reliefweb_report_frequency.csv
│       └── worldbank_context.csv
├── provenance/
│   └── nepal-gorkha-2015/
│       ├── processing_notes.json
│       ├── reliefweb_reports.json
│       ├── usgs_event.json
│       └── worldbank_indicators.json
└── cases/
    ├── wenchuan-2008/
    │   ├── metadata.yml
    │   ├── disaster-impact.csv
    │   ├── ecological-recovery.csv
    │   ├── economic-recovery.csv
    │   ├── population-settlement.csv
    │   ├── social-sensing.csv
    │   └── policy-reconstruction.csv
    ├── japan-311-2011/
    └── nepal-gorkha-2015/</code></pre>
    </div>
  </section>
</BaseLayout>
