---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies } from "../../data/cases.js";

const caseStudy = caseStudies.find((item) => item.id === "japan-311-2011");
---

<BaseLayout title="Japan 3.11 Triple Disaster - Recovery Observatory">
  <section class="case-hero">
    <div class="container">
      <a class="back-link" href={`${import.meta.env.BASE_URL}cases/`}>Case Atlas</a>
      <p class="eyebrow">Case Observatory Scaffold</p>
      <h1>{caseStudy.name}</h1>
      <p class="lead">{caseStudy.researchFocus}</p>
      <div class="hero-meta">
        <span>{caseStudy.country}</span>
        <span>{caseStudy.eventDate}</span>
        <span>M {caseStudy.event.magnitude} {caseStudy.event.magnitudeType}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="card evidence-gap">
        <h2>Template ready for case-specific data.</h2>
        <p>
          Add coastal municipality data, evacuation-zone records, tsunami
          inundation layers, reconstruction policy timelines, and recovery
          indicators to populate the same six-module structure used by Wenchuan.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
