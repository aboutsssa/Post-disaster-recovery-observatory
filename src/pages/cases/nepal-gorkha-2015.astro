---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudies } from "../../data/cases.js";

const caseStudy = caseStudies.find((item) => item.id === "nepal-gorkha-2015");
---

<BaseLayout title="Nepal 2015 Gorkha Earthquake - Recovery Observatory">
  <section class="case-hero">
    <div class="container">
      <a class="back-link" href={`${import.meta.env.BASE_URL}cases/`}>Case Atlas</a>
      <p class="eyebrow">Reference Case</p>
      <h1>{caseStudy.name}</h1>
      <p class="lead">{caseStudy.researchFocus}</p>
      <div class="hero-meta">
        <span>{caseStudy.country}</span>
        <span>{caseStudy.eventDate}</span>
        <span>M {caseStudy.event.magnitude} {caseStudy.event.magnitudeType}</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="card evidence-gap">
        <h2>Himalayan settlement recovery case.</h2>
        <p>
          This case will organize affected-district boundaries, housing
          reconstruction records, accessibility indicators, rural livelihood
          evidence, remote-sensing recovery layers, and policy timelines under
          the same six-module observatory structure used for Wenchuan.
        </p>
      </article>
    </div>
  </section>
  <style>
    .case-hero {
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: clamp(4rem, 8vw, 7rem) 0;
      background: linear-gradient(120deg, rgba(255, 255, 255, 0.94), rgba(231, 240, 238, 0.72));
    }

    .back-link {
      display: inline-flex;
      margin-bottom: 1rem;
      color: var(--terracotta);
      font-size: 0.82rem;
      font-weight: 850;
      text-decoration: none;
      text-transform: uppercase;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }

    .hero-meta span {
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.74);
      padding: 0.3rem 0.65rem;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 800;
    }
  </style>
</BaseLayout>
