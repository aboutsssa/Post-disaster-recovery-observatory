---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseCard from "../components/CaseCard.astro";
import CaseAtlasMap from "../components/CaseAtlasMap.astro";
import { caseStudies, observatoryPrinciples } from "../data/cases.js";
---

<BaseLayout title="Case Atlas - Recovery Observatory">
  <section class="page-hero atlas-hero">
    <div class="container">
      <p class="eyebrow">Case Atlas</p>
      <h1>Pilot cases as entry points.</h1>
      <p class="lead">
        The atlas now works as a clean spatial index. Click a marker or case
        card to open the full observatory page for that disaster.
      </p>
    </div>
  </section>

  <section class="section map-section">
    <div class="container">
      <CaseAtlasMap cases={caseStudies} />
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Pilot Cases</p>
          <h2>Open a case-specific observatory.</h2>
        </div>
        <p>
          Analytical boundaries, module charts, and evidence notes are handled
          inside the individual case pages rather than on this directory page.
        </p>
      </div>
      <div class="grid three">
        {caseStudies.map((caseStudy) => <CaseCard caseStudy={caseStudy} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid three">
        {observatoryPrinciples.map((principle) => (
          <article class="card principle-card">
            <p>{principle}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
