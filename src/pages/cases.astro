---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseCard from "../components/CaseCard.astro";
import CaseAtlasMap from "../components/CaseAtlasMap.astro";
import { caseStudies, observatoryPrinciples } from "../data/cases.js";

const cases = caseStudies.map((caseStudy) => ({
  ...caseStudy,
  summary: caseStudy.researchFocus
}));
---

<BaseLayout title="Case Atlas - Recovery Observatory">
  <section class="page-hero atlas-hero">
    <div class="container">
      <p class="eyebrow">Case Atlas</p>
      <h1>Global case atlas for long-term recovery observation.</h1>
      <p class="lead">
        Each marker locates a disaster case at the global scale. Open a case to
        view its spatial units, recovery indicators, and case-specific evidence.
      </p>
    </div>
  </section>

  <section class="section map-section">
    <div class="container">
      <CaseAtlasMap cases={caseStudies} />
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Pilot Cases</p>
          <h2>Case-specific observatories.</h2>
        </div>
        <p>
          The atlas provides geographic orientation. Detailed county maps,
          module charts, and evidence interpretation are organized inside each
          individual case page.
        </p>
      </div>
      <div class="grid three">
        {cases.map((caseStudy) => <CaseCard caseStudy={caseStudy} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid three">
        {observatoryPrinciples.map((principle) => (
          <article class="card principle-card">
            <p>{principle}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
