---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About · Recovery Observatory">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>ReSpace Lab: Recovery · Space · Resilience.</h1>
      <p class="lead">
        Post-disaster recovery is not a single outcome. It is a long-term
        transformation of space, ecology, economy, settlement, memory, and
        governance. This project turns that premise into a reusable research
        template.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <div class="grid two">
        <article class="card">
          <h3>Project Vision</h3>
          <p>
            Build a comparative observatory that helps researchers document how
            damaged regions recover, adapt, relocate, and sometimes transform
            long after public attention has moved elsewhere.
          </p>
        </article>
        <article class="card">
          <h3>First Scope</h3>
          <p>
            The MVP focuses on structure, language, and deployment readiness:
            pages, data folders, metadata, indicator definitions, and a clear
            pathway toward future geospatial dashboards.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
